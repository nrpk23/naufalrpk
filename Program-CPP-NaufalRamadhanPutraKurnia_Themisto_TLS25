#include <bits/stdc++.h>
using namespace std;

// Output warna pada detik t (t >= 0)
// Siklus standar: [0..19] = Hijau (20s), [20..22] = Kuning (3s), [23..102] = Merah (80s)
// Kita tahu: pada detik 45 lampu = Kuning.
// Maka shift = (20 - 45) mod 103 = 78, agar 45+shift => 20 (awal kuning).
string traffic_light_color(long long t) {
    const int green = 20;
    const int yellow = 3;
    const int red = 80;
    const int cycle = green + yellow + red; // 103

    const int shift = (green - 45) % cycle; // mungkin negatif
    int s = (shift < 0) ? shift + cycle : shift; // buat positive
    int pos = (int)(( (t % cycle) + s ) % cycle); // posisi dalam siklus setelah digeser

    if (pos < green) return "Hijau";
    else if (pos < green + yellow) return "Kuning";
    else return "Merah";
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    cout << "Masukkan detik t (>=0). Program keluar jika input bukan integer.\n";
    long long t;
    while (cin >> t) {
        if (t < 0) {
            cout << "Masukkan detik non-negatif.\n";
            continue;
        }
        cout << "Detik " << t << " : " << traffic_light_color(t) << "\n";
    }
    return 0;
}
