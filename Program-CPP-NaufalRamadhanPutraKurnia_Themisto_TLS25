#include <iostream>
using namespace std;

// Fungsi untuk membalik bilangan secara matematis
int reverseNumber(int x) {
    int sign = (x < 0) ? -1 : 1;
    x = (x < 0) ? -x : x;  // ambil nilai absolut
    
    int rev = 0;
    while (x > 0) {
        rev = rev * 10 + (x % 10);
        x /= 10;
    }
    
    return sign * rev; // kembalikan dengan tanda aslinya
}

int main() {
    int n;
    cin >> n; // panjang array
    
    int arr[n];
    for (int i = 0; i < n; i++) {
        cin >> arr[i]; // input elemen array
    }
    
    long long sum = 0; // gunakan long long biar aman dari overflow
    for (int i = 0; i < n; i++) {
        if (i % 2 == 0) { // indeks genap
            arr[i] = reverseNumber(arr[i]);
        }
        // indeks ganjil tetap
        sum += arr[i];
    }
    
    // Output jumlah
    cout << sum << endl;
    
    return 0;
}




