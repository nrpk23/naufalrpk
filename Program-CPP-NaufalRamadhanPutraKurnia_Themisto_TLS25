#include <iostream>
#include <string>
#include <cctype>
using namespace std;

// Cek vokal (besar/kecil)
bool isVowel(char c) {
    c = tolower(static_cast<unsigned char>(c));
    return (c=='a' || c=='e' || c=='i' || c=='o' || c=='u');
}

// Fungsi reverse user-defined (tidak boleh pakai std::reverse)
string myReverse(const string &s) {
    string t = s;
    int i = 0, j = (int)t.size() - 1;
    while (i < j) {
        char tmp = t[i];
        t[i] = t[j];
        t[j] = tmp;
        ++i; --j;
    }
    return t;
}

// Buat password dari kata asli
string makePassword(const string &word) {
    if (word.empty()) return "";

    // 1) ambil huruf non-vokal (konsonan) dalam urutan asli
    string consonants;
    for (char c : word) {
        if (!isVowel(c)) consonants.push_back(c);
    }

    // 2) balikkan semua huruf (menggunakan fungsi user-defined)
    string rev = myReverse(consonants);

    // 3) ambil kode ASCII huruf pertama kata asli sebagai integer
    int asciiVal = static_cast<unsigned char>(word[0]);

    // 4) masukkan ascii (sebagai desimal string) di tengah rev
    string asciiStr = to_string(asciiVal);
    int mid = (int)rev.size() / 2; // floor(len/2)
    string password = rev.substr(0, mid) + asciiStr + rev.substr(mid);

    return password;
}

// Dari password -> dapatkan sebagian kata asli (konsonan + huruf pertama bila hilang)
string reconstructPartial(const string &password) {
    if (password.empty()) return "";

    // 1) temukan substring angka (kode ASCII) — asumsi: satu blok digit kontigu berada di tengah
    int n = (int)password.size();
    int startDigit = -1, endDigit = -1; // [startDigit, endDigit)
    for (int i = 0; i < n; ++i) {
        if (isdigit(static_cast<unsigned char>(password[i]))) {
            if (startDigit == -1) startDigit = i;
            endDigit = i + 1;
        }
    }

    if (startDigit == -1) {
        // Tidak ada angka -> tidak sesuai format
        return ""; 
    }

    // 2) ekstrak angka -> jadi integer ascii
    string digitPart = password.substr(startDigit, endDigit - startDigit);
    int asciiVal = stoi(digitPart);
    char firstChar = static_cast<char>(asciiVal);

    // 3) sisa string = password tanpa bagian angka -> ini adalah versi 'rev' (rev = reversed consonants)
    string rev = password.substr(0, startDigit) + password.substr(endDigit);

    // 4) balikkan rev menggunakan myReverse untuk mendapatkan urutan konsonan asli
    string consonantsOrig = myReverse(rev);

    // 5) jika huruf dari ascii belum ada di depan (mis. huruf pertama asli vokal dan dihapus),
    //    maka tambahkan di depan. Jika sudah sama, jangan duplikasi.
    if (consonantsOrig.empty() || consonantsOrig[0] != firstChar) {
        consonantsOrig = string(1, firstChar) + consonantsOrig;
    }

    // Hasil: sebagian kata asli (konsonan + huruf pertama jika hilang)
    return consonantsOrig;
}

int main() {
    // Contoh dari soal
    string a1 = "banana";
    string a2 = "Jakarta";
    string a3 = "TANGERANG";

    cout << "=== Generate password ===\n";
    cout << a1 << " -> " << makePassword(a1) << "\n";
    cout << a2 << " -> " << makePassword(a2) << "\n";
    cout << a3 << " -> " << makePassword(a3) << "\n\n";

    cout << "=== Reconstruct partial original from password ===\n";
    cout << "nn98b  -> " << reconstructPartial("nn98b") << "  (expect: bnn)\n";
    cout << "tr74kJ -> " << reconstructPartial("tr74kJ") << "  (expect: Jkrt)\n";
    cout << "GNR84GNT -> " << reconstructPartial("GNR84GNT") << " (expect: T G N G R N G? actually: T G N G R N G without vowels -> check below)\n";

    // Contoh interaktif (opsional)
    string input;
    cout << "\nMasukkan kata untuk generate password (atau enter untuk skip): ";
    getline(cin, input);
    if (!input.empty()) {
        cout << "Password: " << makePassword(input) << "\n";
    }

    cout << "\nMasukkan sandi untuk reconstruct (atau enter untuk keluar): ";
    getline(cin, input);
    if (!input.empty()) {
        cout << "Partial original: " << reconstructPartial(input) << "\n";
    }

    return 0;
}



